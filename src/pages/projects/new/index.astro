---

import { getCollection } from "astro:content";
import BaseHead from "@/components/layout/BaseHead.astro";
import Navigation from "@/components/layout/Navigation.astro";
import "../../../styles/global.css";

const projects = (await getCollection("project"))
	.sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date));

const PLACEHOLDER = "https://placehold.co/1920x1080.webp?text=Image+Not+Found";
---


<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Projects"
			description="Projects"
			image="/og/projects.png"
		/>
		<style>
			.projects-scroll-container {
				display: flex;
				flex-direction: row;
				height: 100vh;
				background: #0a0a0a;
			}
			.projects-list-outer {
				width: 45vw;
				min-width: 320px;
				max-width: 600px;
				height: 100vh;
				overflow-y: auto;
				position: relative;
				z-index: 2;
				scroll-behavior: smooth;
				background: transparent;
			}
			.projects-list {
				display: flex;
				flex-direction: column;
				justify-content: flex-start;
				min-height: 100vh;
				padding: 0 2rem;
			}
			.project-item {
				min-height: 80vh;
				display: flex;
				flex-direction: column;
				justify-content: center;
				border-left: 4px solid transparent;
				padding: 2rem 0;
				transition: border-color 0.3s;
			}
			.project-item.active {
				border-color: #a3e635;
			}
			.project-title {
				font-size: 2.5rem;
				font-weight: bold;
				color: #fff;
				margin-bottom: 1rem;
			}
			.project-desc {
				color: #cbd5e1;
				font-size: 1.2rem;
				line-height: 1.6;
			}
			.projects-hero {
				width: 55vw;
				min-width: 400px;
				height: 100vh;
				position: sticky;
				top: 0;
				right: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				background: #18181b;
				overflow: hidden;
			}
			.hero-image {
				position: absolute;
				top: 50%;
				left: 50%;
				width: 80%;
				max-width: 900px;
				max-height: 80vh;
				object-fit: contain;
				border-radius: 1.5rem;
				box-shadow: 0 8px 32px 0 rgba(0,0,0,0.25);
				opacity: 0;
				transform: translate(-50%, -50%) rotateX(60deg) scale(0.9);
				transition: opacity 0.5s, transform 0.7s cubic-bezier(.4,2,.3,1);
				z-index: 1;
			}
			.hero-image.active {
				opacity: 1;
				transform: translate(-50%, -50%) rotateX(0deg) scale(1);
				z-index: 2;
			}
			.hero-image.prev, .hero-image.next {
				opacity: 0.3;
				transform: translate(-50%, -50%) rotateX(60deg) scale(0.85);
				z-index: 1;
			}
			@media (max-width: 900px) {
				.projects-scroll-container {
					flex-direction: column;
				}
				.projects-list-outer, .projects-hero {
					width: 100vw;
					min-width: 0;
					max-width: none;
				}
				.projects-hero {
					height: 40vh;
					min-width: 0;
				}
				.project-item {
					min-height: 40vh;
				}
			}
		</style>
	</head>
	<body class="bg-black">
		<Navigation />
		<div class="projects-scroll-container">
			<div class="projects-list-outer" id="projects-list-outer">
				<div class="projects-list" id="projects-list">
					{projects.map((project, idx) => (
						<section
							class={"project-item" + (idx === 0 ? " active" : "")}
							data-idx={idx}
							id={"project-" + idx}
							tabindex="0"
						>
							<h2 class="project-title">{project.data.title}</h2>
							<p class="project-desc">{project.data.description}</p>
						</section>
					))}
				</div>
			</div>
			<div class="projects-hero" id="projects-hero">
				{projects.map((project, idx) => {
					const hero = project.data.heroImage || null;
					return (
						<img
							src={hero ? hero : PLACEHOLDER}
							alt={project.data.title + " hero image"}
							class={"hero-image" + (idx === 0 ? " active" : "")}
							data-idx={idx}
							loading="lazy"
						/>
					);
				})}
			</div>
		</div>
		<script>
			// Vanilla JS for scroll sync and dialpad rotation
			const projects = Array.from(document.querySelectorAll('.project-item'));
			const images = Array.from(document.querySelectorAll('.hero-image'));
			const listOuter = document.getElementById('projects-list-outer');
			let ticking = false;

			function updateActiveProject() {
				if (!listOuter) return;
				let activeIdx = 0;
				let minDist = Infinity;
				projects.forEach((section, idx) => {
					const rect = section.getBoundingClientRect();
					// Use the center of the scrollable area for reference
					const parentRect = listOuter.getBoundingClientRect();
					const center = parentRect.top + parentRect.height / 2;
					const dist = Math.abs(rect.top + rect.height / 2 - center);
					if (dist < minDist) {
						minDist = dist;
						activeIdx = idx;
					}
				});
				projects.forEach((section, idx) => {
					section.classList.toggle('active', idx === activeIdx);
				});
				images.forEach((img, idx) => {
					img.classList.remove('active', 'prev', 'next');
					if (idx === activeIdx) {
						img.classList.add('active');
					} else if (idx === activeIdx - 1) {
						img.classList.add('prev');
					} else if (idx === activeIdx + 1) {
						img.classList.add('next');
					}
				});
			}

			function onScroll() {
				if (!ticking) {
					window.requestAnimationFrame(() => {
						updateActiveProject();
						ticking = false;
					});
					ticking = true;
				}
			}

			if (listOuter) {
				listOuter.addEventListener('scroll', onScroll, { passive: true });
			}
			window.addEventListener('resize', updateActiveProject);
			document.addEventListener('DOMContentLoaded', updateActiveProject);
		</script>
	</body>
</html>
