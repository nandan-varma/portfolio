---
// Super Timeline Projects Page
import { getCollection } from "astro:content";
import Timeline from "@/components/Timeline.astro";
import BaseHead from "@/components/layout/BaseHead.astro";
import Navigation from "@/components/layout/Navigation.astro";
import "../../styles/global.css";
import BackgroundAnimation from "@/components/animations/BackgroundAnimation.astro";

const projects = (await getCollection("project"))
  .filter((p) => p.data.published === true)
  .sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Projects"
      description="A curated collection of projects that showcase innovation, craft, and attention to detail."
    />
  </head>
  <body class="bg-black text-slate-100">
	<BackgroundAnimation />
    <Navigation />
    <main>
      <Timeline projects={projects.map(p => p.data)} />
    </main>
  </body>
</html>
