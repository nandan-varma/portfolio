---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/cards/Card.astro";
import Article from "@/components/content/Article.astro";
import { SITE_TITLE } from "@/consts";

const projects = (await getCollection("project")).filter(
	(project) => project.data.published,
);

// Impressiveness rank, mirrors the tiers in Claude/Resume/Projects.md (T1 > T2 > T3),
// with projects that never made that list ranked below T3 by recency.
const impressivenessRank: Record<string, number> = {
	// T1
	"PushStack": 1,
	"MarsOS": 2,
	"Nemesis": 3,
	"purgeit": 4,
	"Sigrun": 5,
	"Textedit": 6,
	"GitFlow Studio": 7,
	"Meadows Compiler": 8,
	"Fexer": 9,
	"PipeForge": 10,
	"Platex": 11,
	"Atlas": 12,
	// T2
	"Replog": 13,
	"Friday": 14,
	"JobMatch": 15,
	"Calendar SDK": 16,
	"Flagbase": 17,
	"Lost & Found": 18,
	"CronView": 19,
	"Music": 20,
	"Chess Online": 21,
	"Drift": 22,
	"SwiftAgentKit": 23,
	"Font Synthesis": 24,
	"Pluto OS": 25,
	"Neptune": 26,
	// T3
	"Notor": 27,
	"NightShift": 28,
	"Peek": 29,
	"Calendar": 30,
	"Chats": 31,
	"Chain Reaction": 32,
	"OpenBand": 33,
	"Metarics": 34,
	"nandan.fyi": 35,
	// Never made the resume's project list - ranked below T3 by recency
	"Productivity": 36,
	"Handwriting": 37,
	"Puzzles": 38,
	"Podcasts": 39,
	"File Explorer": 40,
	"Bingo": 41,
};

const sorted = [...projects].sort(
	(a, b) =>
		(impressivenessRank[a.data.title] ?? 99) -
		(impressivenessRank[b.data.title] ?? 99),
);

const featured = sorted.find((project) => project.data.title === "PushStack");
const top2 = sorted.find((project) => project.data.title === "MarsOS");
const top3 = sorted.find((project) => project.data.title === "Nemesis");

// remove featured top2 top3 project from sorted list
if (featured) sorted.splice(sorted.indexOf(featured), 1);
if (top2) sorted.splice(sorted.indexOf(top2), 1);
if (top3) sorted.splice(sorted.indexOf(top3), 1);
---

<Layout
	title={`Projects | ${SITE_TITLE}`}
	description={
		"Software projects by Nandan Varma - operating systems, compilers, developer tools, and full-stack apps built from scratch."
	}
	image="/og/projects.png"
>
	<div class="px-6 pt-32 pb-16 mx-auto space-y-12 max-w-6xl w-full lg:px-8 lg:pt-40">
		<h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-fg" transition:name={"Projects"}>
			Projects
		</h1>

		<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
			<a href={`/projects/${featured?.id}`} class="block h-full group">
				<Card reveal class="h-full">
					<article class="relative w-full h-full p-6 md:p-10 flex flex-col">
						<span class="text-xs font-medium text-muted-fg">
							{
								featured?.data.date ? (
									<time
										datetime={new Date(
											featured?.data.date + "T12:00:00",
										).toISOString()}
									>
										{Intl.DateTimeFormat(undefined, {
											dateStyle: "medium",
										}).format(
											new Date(featured?.data.date + "T12:00:00"),
										)}
									</time>
								) : (
									<span>SOON</span>
								)
							}
						</span>

						<h2
							class="mt-4 text-3xl sm:text-4xl font-bold text-fg transition-colors duration-300 group-hover:text-brand"
							transition:name={"project-title-" + featured?.data.title}
						>
							{featured?.data.title}
						</h2>
						<p
							class="mt-4 leading-8 text-muted-fg"
							transition:name={"project-desc-" + featured?.data.title}
						>
							{featured?.data.description}
						</p>
						<p class="mt-auto pt-6 text-brand font-semibold hidden lg:block">
							Read more <span aria-hidden="true">&rarr;</span>
						</p>
					</article>
				</Card>
			</a>

			<div class="grid grid-rows-2 w-full gap-6">
				{
					[top2, top3]
						.filter((project) => project !== undefined)
						.map((project, i) => (
							<Card reveal style={`transition-delay: ${(i + 1) * 80}ms`}>
								<Article id={project.id} project={project.data} views={0} />
							</Card>
						))
				}
			</div>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
			{
				sorted.map((project, i) => (
					<Card reveal style={`transition-delay: ${(i % 6) * 50}ms`}>
						<Article id={project.id} project={project.data} views={0} />
					</Card>
				))
			}
		</div>
	</div>
</Layout>

<script is:inline>
  function setupProjectsTracking() {
    // Track project card clicks from the listing page
    var projectLinks = document.querySelectorAll('a[href^="/projects/"]');
    projectLinks.forEach(function(link) {
      link.removeEventListener('click', handleProjectCardClick);
      link.addEventListener('click', handleProjectCardClick);
    });
  }

  function handleProjectCardClick(event) {
    var link = event.currentTarget;
    var href = link.getAttribute('href');
    var projectId = href ? href.replace('/projects/', '') : '';
    var titleEl = link.querySelector('h2');
    var title = titleEl ? titleEl.textContent?.trim() : projectId;
    window.posthog?.capture('project_card_clicked', {
      project_id: projectId,
      project_title: title
    });
  }

  document.addEventListener('DOMContentLoaded', setupProjectsTracking);
  document.addEventListener('astro:page-load', setupProjectsTracking);
</script>
