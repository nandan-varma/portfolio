---
import { getCollection } from "astro:content";
import Navigation from "@/components/layout/Navigation.astro";
import "../../styles/global.css";
import GlassCard from "@/components/cards/GlassCard.astro";
import Article from "@/components/content/Article.astro";
import BaseHead from "@/components/layout/BaseHead.astro";
import BackgroundAnimation from "@/components/animations/BackgroundAnimation.astro";

const projects = await getCollection("project");

// Impressiveness rank, mirrors the tiers in Claude/Resume/Projects.md (T1 > T2 > T3),
// with projects that never made that list ranked below T3 by recency.
const impressivenessRank: Record<string, number> = {
	// T1
	"PushStack": 1,
	"MarsOS": 2,
	"Nemesis": 3,
	"Sigrun": 4,
	"Textedit": 5,
	"GitFlow Studio": 6,
	"Meadows Compiler": 7,
	"Fexer": 8,
	"PipeForge": 9,
	"Platex": 10,
	"Atlas": 11,
	// T2
	"Replog": 12,
	"Friday": 13,
	"JobMatch": 14,
	"Calendar SDK": 15,
	"Flagbase": 16,
	"Lost & Found": 17,
	"CronView": 18,
	"Music": 19,
	"Chess Online": 20,
	"Drift": 21,
	"SwiftAgentKit": 22,
	"Font Synthesis": 23,
	"Pluto OS": 24,
	"Neptune": 25,
	// T3
	"Notor": 26,
	"NightShift": 27,
	"Peek": 28,
	"Calendar": 29,
	"Chats": 30,
	"Chain Reaction": 31,
	"OpenBand": 32,
	"Metarics": 33,
	"nandanvarma.com": 34,
	// Never made the resume's project list - ranked below T3 by recency
	"Productivity": 35,
	"Handwriting": 36,
	"Puzzles": 37,
	"Podcasts": 38,
	"File Explorer": 39,
	"Bingo": 40,
};

const sorted = [...projects].sort(
	(a, b) =>
		(impressivenessRank[a.data.title] ?? 99) -
		(impressivenessRank[b.data.title] ?? 99),
);

const featured = sorted.find((project) => project.data.title === "PushStack");
const top2 = sorted.find((project) => project.data.title === "MarsOS");
const top3 = sorted.find((project) => project.data.title === "Nemesis");

// remove featured top2 top3 project from sorted list
if (featured) sorted.splice(sorted.indexOf(featured), 1);
if (top2) sorted.splice(sorted.indexOf(top2), 1);
if (top3) sorted.splice(sorted.indexOf(top3), 1);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={"Projects"}
			description={"Projects"}
			image="/og/projects.png"
		/>
	</head>
	<body class="bg-black">
		<BackgroundAnimation />
		<Navigation />
		<div class="relative pb-16">
			<div
				class="px-6 pt-16 mx-auto space-y-8 max-w-7xl lg:px-8 md:space-y-16 md:pt-24 lg:pt-32"
			>
				<div class="max-w-2xl lg:mx-0">
					<h2
						class="text-3xl font-bold tracking-tight text-zinc-100 sm:text-4xl"
						transition:name={"Projects"}
					>
						Projects
					</h2>
				</div>

				<div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
					<a href={`/projects/${featured?.id}`} class="block h-full">
						<GlassCard class="h-full">
							<article
								class="relative w-full p-4 md:p-8 flex flex-col min-h-full"
								tabindex={-1}
							>
								<div
									class="flex justify-between gap-2 items-center"
								>
									<div class="text-xs text-zinc-100">
										{
											featured?.data.date ? (
												<time
													datetime={new Date(
														featured?.data.date + "T12:00:00",
													).toISOString()}
												>
													{Intl.DateTimeFormat(
														undefined,
														{
															dateStyle: "medium",
														},
													).format(
														new Date(
															featured?.data.date + "T12:00:00",
														),
													)}
												</time>
											) : (
												<span>SOON</span>
											)
										}
									</div>
								</div>

								<h2
									id="featured?-post"
									class="mt-4 text-3xl font-bold text-zinc-100 group-hover:text-white sm:text-4xl font-display"
									transition:name={"project-title-" +
										featured?.data.title}
								>
									{featured?.data.title}
								</h2>
								<p
									class="mt-4 leading-8 duration-150 text-zinc-400 group-hover:text-zinc-300 flex-1"
									transition:name={"project-desc-" +
										featured?.data.title}
								>
									{featured?.data.description}
								</p>
								<div class="pt-4">
									<p
										class="text-zinc-200 hover:text-zinc-50 hidden lg:block"
									>
										Read more <span aria-hidden="true"
											>&rarr;</span
										>
									</p>
								</div>
							</article>
						</GlassCard>
					</a>

					<div
						class="flex flex-col w-full gap-8 border-t border-gray-900/10 lg:border-t-0"
					>
						{
							[top2, top3]
								.filter((project) => project !== undefined)
								.map((project) => (
									<GlassCard>
										<Article
											id={project.id}
											project={project.data}
											views={0}
										/>
									</GlassCard>
								))
						}
					</div>
				</div>

				<div
					class="grid grid-cols-1 gap-4 lg:mx-0 md:grid-cols-3"
				>
					<div class="grid grid-cols-1 gap-4">
						{
							sorted
								.filter((_, i) => i % 3 === 0)
								.map((project) => (
									<GlassCard>
										<Article
											id={project.id}
											project={project.data}
											views={0}
										/>
									</GlassCard>
								))
						}
					</div>
					<div class="grid grid-cols-1 gap-4">
						{
							sorted
								.filter((_, i) => i % 3 === 1)
								.map((project) => (
									<GlassCard>
										<Article
											id={project.id}
											project={project.data}
											views={0}
										/>
									</GlassCard>
								))
						}
					</div>
					<div class="grid grid-cols-1 gap-4">
						{
							sorted
								.filter((_, i) => i % 3 === 2)
								.map((project) => (
									<GlassCard>
										<Article
											id={project.id}
											project={project.data}
											views={0}
										/>
									</GlassCard>
								))
						}
					</div>
				</div>
			</div>
		</div>
	</body>
</html>

<script is:inline>
  function setupProjectsTracking() {
    // Track project card clicks from the listing page
    var projectLinks = document.querySelectorAll('a[href^="/projects/"]');
    projectLinks.forEach(function(link) {
      link.removeEventListener('click', handleProjectCardClick);
      link.addEventListener('click', handleProjectCardClick);
    });
  }

  function handleProjectCardClick(event) {
    var link = event.currentTarget;
    var href = link.getAttribute('href');
    var projectId = href ? href.replace('/projects/', '') : '';
    var titleEl = link.querySelector('h2');
    var title = titleEl ? titleEl.textContent?.trim() : projectId;
    window.posthog?.capture('project_card_clicked', {
      project_id: projectId,
      project_title: title
    });
  }

  document.addEventListener('DOMContentLoaded', setupProjectsTracking);
  document.addEventListener('astro:page-load', setupProjectsTracking);
</script>
