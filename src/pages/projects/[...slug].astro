---
import { type CollectionEntry, getCollection } from "astro:content";
import ProjectPost from "../../layouts/ProjectPost.astro";
import Layout from "@/layouts/Layout.astro";
import "@/styles/mdx.css";

import { render } from "astro:content";
import { SITE_TITLE } from "@/consts";

export async function getStaticPaths() {
	const posts = await getCollection("project");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<"project">;

const post = Astro.props;
const { Content } = await render(post);
---

<Layout
	title={`${post.data.title} | ${SITE_TITLE}`}
	description={post.data.description}
	image={`/og/project/${post.id}.png`}
	noindex={!post.data.published}
>
	<ProjectPost {...post.data}>
		<article class="w-full py-4 mdx-body">
			<Content />
		</article>
	</ProjectPost>
</Layout>

<script is:inline define:vars={{ postId: post.id, postTitle: post.data.title }}>
	function trackProjectOpened() {
		window.posthog?.capture("project_opened", {
			project_id: postId,
			project_title: postTitle,
		});
	}

	document.addEventListener("DOMContentLoaded", trackProjectOpened);
	document.addEventListener("astro:page-load", trackProjectOpened);
</script>
