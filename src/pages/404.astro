---
import Layout from "@/layouts/Layout.astro";
import { SITE_TITLE } from "@/consts";
---

<Layout
	title={`404 - Page not found | ${SITE_TITLE}`}
	description={"The page you're looking for doesn't exist."}
	noindex
	nav={false}
>
	<div class="flex-1 flex flex-col items-center justify-center gap-6 px-6 text-center">
		<div class="text-8xl sm:text-9xl font-extrabold gradient-text animate-fade-up">
			404
		</div>
		<h1 class="text-2xl sm:text-3xl font-bold text-fg animate-fade-up" style="animation-delay: 0.08s;">
			Page not found
		</h1>
		<p class="max-w-md text-muted-fg animate-fade-up" style="animation-delay: 0.16s;">
			Whatever you were looking for isn't here. Let's get you back on solid ground.
		</p>
		<div class="flex flex-wrap items-center justify-center gap-3 mt-2 animate-fade-up" style="animation-delay: 0.24s;">
			<a href="/" class="btn btn-primary text-lg">
				Take me home
			</a>
			<a href="/contact" class="btn btn-secondary text-lg">
				Contact
			</a>
		</div>
	</div>
</Layout>

<script is:inline>
	window.posthog?.capture("page_not_found", {
		path: window.location.pathname,
		referrer: document.referrer || null,
	});
</script>
