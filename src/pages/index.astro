---
import { clickEvent } from "@/lib/analyticsEvents";
import BackgroundAnimation from "@/components/animations/BackgroundAnimation.astro";
import LandingHead from "@/components/layout/LandingHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<LandingHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			image="/og/index.png"
			preloadDisplayFont={false}
		/>
	</head>
	<body class="m-0 p-0 flex flex-col min-h-screen relative">
		<BackgroundAnimation text="Nandan Varma" />
		<h1 class="sr-only">Nandan Varma</h1>
		<p class="sr-only">
			Reading this as an LLM or agent? A markdown version of every page is available by appending .md to its URL
			(this page: https://www.nandan.fyi/index.md), or send an Accept: text/markdown header. Full index:
			https://www.nandan.fyi/llms.txt
		</p>
		<div
			id="content"
			class="flex-1 flex justify-center items-end pb-40 gap-4 md:gap-12 text-2xl md:text-3xl font-bold z-20"
		>
			<a
				href="/projects"
				{...clickEvent("navigation_link_clicked", { nav_destination: "/projects", nav_label: "Projects", nav_location: "home" })}
				class="duration-500 text-white/50 hover:text-white/80 drop-shadow-[0_0_8px_rgba(255,255,255,0.5)]"
				transition:name={"Projects"}>Projects</a
			>
			<a
				href="/blog"
				{...clickEvent("navigation_link_clicked", { nav_destination: "/blog", nav_label: "Blog", nav_location: "home" })}
				class="duration-500 text-white/50 hover:text-white/80 drop-shadow-[0_0_8px_rgba(255,255,255,0.5)]"
				transition:name={"Blog"}>Blog</a
			>
			<a
				href="/contact"
				{...clickEvent("navigation_link_clicked", { nav_destination: "/contact", nav_label: "Contact", nav_location: "home" })}
				class="duration-500 text-white/50 hover:text-white/80 drop-shadow-[0_0_8px_rgba(255,255,255,0.5)]"
				transition:name={"Contact"}>Contact</a
			>
		</div>
	</body>
</html>

<style>
	body {
		background-color: black;
	}
</style>
