---
import Layout from "@/layouts/Layout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<Layout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	image="/og/index.png"
	navPosition="bottom"
	navShowBack={false}
>
	<div class="flex-1 flex flex-col items-center justify-center gap-8 px-6 pb-28 text-center">
		<p class="chip animate-fade-up">👋 hey, I build things</p>

		<h1
			class="text-5xl sm:text-7xl md:text-8xl font-extrabold tracking-tight gradient-text animate-fade-up"
			style="animation-delay: 0.08s;"
			transition:name={"Nandan Varma"}
		>
			Nandan Varma
		</h1>

		<p
			class="max-w-xl text-lg sm:text-xl text-muted-fg animate-fade-up"
			style="animation-delay: 0.16s;"
		>
			Software engineer building operating systems, compilers, and
			full-stack apps &mdash; usually all three before breakfast.
		</p>
	</div>
</Layout>
