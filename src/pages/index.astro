---
import { getCollection } from "astro:content";
import BaseHead from "@/components/layout/BaseHead.astro";
import GridBackground from "@/components/animations/GridBackground.astro";
import HeroSection from "@/components/hero/HeroSection.astro";
import ProjectShowcase from "@/components/showcase/ProjectShowcase.astro";
import BlogShowcase from "@/components/showcase/BlogShowcase.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const projects = (await getCollection("project"))
	.filter((project) => project.data.published)
	.sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date))
	.map((post) => post);

const blogs = (await getCollection("blog"))
	.sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date))
	.filter((post) => !post.data.draft)
	.map((post) => post);

const featuredProjects = projects.slice(0, 3);
const latestBlogs = blogs.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			image="/og/index.png"
		/>
	</head>
	<body class="bg-black min-h-screen overflow-x-hidden">
		<GridBackground />

		<main class="relative z-10">
			<HeroSection />

			<section class="min-h-screen flex flex-col justify-center px-6 mx-auto max-w-7xl lg:px-8 py-24">
				<div class="flex items-center gap-4 mb-12">
					<h2 class="text-3xl md:text-4xl font-bold text-zinc-100">
						Featured Work
					</h2>
					<div class="h-px flex-1 bg-zinc-800"></div>
					<a href="/projects" class="text-zinc-500 hover:text-zinc-300 transition-colors text-sm">
						View all {projects.length} →
					</a>
				</div>
				
				<ProjectShowcase projects={featuredProjects} />
			</section>

			<section class="min-h-screen flex flex-col justify-center px-6 mx-auto max-w-7xl lg:px-8 py-24">
				<div class="flex items-center gap-4 mb-12">
					<h2 class="text-3xl md:text-4xl font-bold text-zinc-100">
						Latest Articles
					</h2>
					<div class="h-px flex-1 bg-zinc-800"></div>
					<a href="/blog" class="text-zinc-500 hover:text-zinc-300 transition-colors text-sm">
						View all {blogs.length} →
					</a>
				</div>
				
				<BlogShowcase blogs={latestBlogs} />
			</section>

			<section class="min-h-[50vh] flex flex-col justify-center items-center text-center px-6 py-24">
				<div class="max-w-2xl animate-fade-in">
					<h2 class="text-3xl md:text-5xl font-bold text-zinc-100 mb-6">
						Let's work together
					</h2>
					<p class="text-lg text-zinc-400 mb-10">
						I'm always open to discussing new projects, creative ideas, or opportunities to be part of your vision.
					</p>
					<a
						href="/contact"
						class="inline-block px-10 py-5 bg-zinc-100 text-zinc-900 rounded-full font-medium text-lg hover:bg-zinc-200 transition-all duration-300 hover:scale-105"
					>
						Start a Conversation
					</a>
				</div>
			</section>

			<footer class="border-t border-zinc-800/60 py-12 px-6">
				<div class="mx-auto max-w-7xl flex flex-col md:flex-row justify-between items-center gap-6">
					<p class="text-zinc-500 text-sm">
						© {new Date().getFullYear()} Nandan Varma. All rights reserved.
					</p>
					<nav class="flex flex-wrap gap-6 md:gap-12">
						<a href="/projects" class="text-zinc-400 hover:text-zinc-200 transition-colors duration-300">Projects</a>
						<a href="/blog" class="text-zinc-400 hover:text-zinc-200 transition-colors duration-300">Blog</a>
						<a href="/contact" class="text-zinc-400 hover:text-zinc-200 transition-colors duration-300">Contact</a>
						<a href="https://github.com/nandan-varma" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-zinc-200 transition-colors duration-300">GitHub</a>
						<a href="https://twitter.com/nandanvarma_" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-zinc-200 transition-colors duration-300">Twitter</a>
					</nav>
				</div>
			</footer>
		</main>
	</body>
</html>