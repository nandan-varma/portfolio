---
import { getCollection } from "astro:content";
import Navigation from "@/components/layout/Navigation.astro";
import BaseHead from "@/components/layout/BaseHead.astro";
import BlogsGrid from "@/components/BlogsGrid.astro";

const blogs = (await getCollection("blog"))
	.sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date))
	.filter((post) => !post.data.draft)
	.map((post) => post);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={"Blog"} description={"Blog"} image="/og/blog.png" />
	</head>
	<body class="bg-black min-h-screen">
		<Navigation />
		<main class="relative z-10 px-6 mx-auto max-w-7xl lg:px-8 py-16 md:py-24 lg:py-32">
			<BlogsGrid blogs={blogs} showAll={true} />
		</main>
	</body>
</html>