---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/cards/Card.astro";
import Blog from "@/components/content/Blog.astro";
import { SITE_TITLE } from "@/consts";

const sorted = (await getCollection("blog"))
	.sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date))
	.filter((post) => !post.data.draft);

const featured = sorted[0];
const top2 = sorted[1];
const top3 = sorted[2];

const remaining = sorted.slice(3);
---

<Layout
	title={`Blog | ${SITE_TITLE}`}
	description={
		"Writing by Nandan Varma on software engineering, side projects, and what building them taught him."
	}
	image="/og/blog.png"
>
	<div class="px-6 pt-32 pb-16 mx-auto space-y-12 max-w-6xl w-full lg:px-8 lg:pt-40">
		<h1
			class="text-4xl sm:text-5xl font-bold tracking-tight text-fg gradient-text"
			transition:name={"Blog"}
		>
			Blog
		</h1>

		<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
			<a href={`/blog/${featured?.id}`} class="block h-full group">
				<Card reveal class="h-full">
					<article class="relative w-full p-6 md:p-10 flex flex-col min-h-full">
						<span class="text-xs font-medium text-muted-fg">
							{featured?.data.date ? (
								<time datetime={new Date(featured?.data.date + "T12:00:00").toISOString()}>
									{Intl.DateTimeFormat(undefined, { dateStyle: "medium" }).format(new Date(featured?.data.date + "T12:00:00"))}
								</time>
							) : (
								<span>SOON</span>
							)}
						</span>
						<h2
							class="mt-4 text-3xl sm:text-4xl font-bold text-fg transition-colors duration-300 group-hover:text-brand"
							transition:name={"blog-title-" + featured?.data.title}
						>
							{featured?.data.title}
						</h2>
						<p
							class="mt-4 leading-8 text-muted-fg flex-1"
							transition:name={"blog-desc-" + featured?.data.title}
						>
							{featured?.data.description}
						</p>
						<div class="pt-4">
							<p class="text-brand font-semibold hidden lg:block">
								Read more <span aria-hidden="true">&rarr;</span>
							</p>
						</div>
					</article>
				</Card>
			</a>

			<div class="flex flex-col w-full gap-6">
				{[top2, top3].filter((b) => b !== undefined).map((blog, i) => (
					<Card reveal style={`transition-delay: ${(i + 1) * 80}ms`}>
						<Blog id={blog.id} blog={blog.data} views={0} />
					</Card>
				))}
			</div>
		</div>

		<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
			<div class="grid grid-cols-1 gap-4">
				{remaining.filter((_, i) => i % 3 === 0).map((blog, i) => (
					<Card reveal style={`transition-delay: ${(i % 5) * 60}ms`}>
						<Blog id={blog.id} blog={blog.data} views={0} />
					</Card>
				))}
			</div>
			<div class="grid grid-cols-1 gap-4">
				{remaining.filter((_, i) => i % 3 === 1).map((blog, i) => (
					<Card reveal style={`transition-delay: ${(i % 5) * 60}ms`}>
						<Blog id={blog.id} blog={blog.data} views={0} />
					</Card>
				))}
			</div>
			<div class="grid grid-cols-1 gap-4">
				{remaining.filter((_, i) => i % 3 === 2).map((blog, i) => (
					<Card reveal style={`transition-delay: ${(i % 5) * 60}ms`}>
						<Blog id={blog.id} blog={blog.data} views={0} />
					</Card>
				))}
			</div>
		</div>
	</div>
</Layout>

<script is:inline>
  function setupBlogTracking() {
    // Track blog post card clicks from the listing page
    var blogLinks = document.querySelectorAll('a[href^="/blog/"]');
    blogLinks.forEach(function(link) {
      link.removeEventListener('click', handleBlogCardClick);
      link.addEventListener('click', handleBlogCardClick);
    });
  }

  function handleBlogCardClick(event) {
    var link = event.currentTarget;
    var href = link.getAttribute('href');
    var postId = href ? href.replace('/blog/', '') : '';
    var titleEl = link.querySelector('h2');
    var title = titleEl ? titleEl.textContent?.trim() : postId;
    window.posthog?.capture('blog_post_card_clicked', {
      post_id: postId,
      post_title: title
    });
  }

  document.addEventListener('DOMContentLoaded', setupBlogTracking);
  document.addEventListener('astro:page-load', setupBlogTracking);
</script>
