---
import { getCollection } from "astro:content";
import Navigation from "@/components/layout/Navigation.astro";
import "../../styles/global.css";
import GlassCard from "@/components/cards/GlassCard.astro";
import Blog from "@/components/content/Blog.astro";
import BaseHead from "@/components/layout/BaseHead.astro";
import BackgroundAnimation from "@/components/animations/BackgroundAnimation.astro";

const sorted = (await getCollection("blog"))
	.sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date))
	.filter((post) => !post.data.draft);

const featured = sorted[0];
const top2 = sorted[1];
const top3 = sorted[2];

// remove featured/top from sorted list
const remaining = sorted.slice(3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={"Blog"} description={"Blog"} image="/og/blog.png" />
	</head>
	<body class="bg-black">
		<BackgroundAnimation />
		<Navigation />
		<div class="relative pb-16">
			<div
				class="px-6 pt-16 mx-auto space-y-8 max-w-7xl lg:px-8 md:space-y-16 md:pt-24 lg:pt-32"
			>
				<div class="max-w-2xl lg:mx-0">
					<h2
						class="text-3xl font-bold tracking-tight text-zinc-100 sm:text-4xl"
						transition:name={"Blog"}
					>
						Blog
					</h2>
				</div>

				<div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
					<a href={`/blog/${featured?.id}`} class="block h-full">
						<GlassCard class="h-full">
							<article
								class="relative w-full p-4 md:p-8 flex flex-col min-h-full"
								tabindex={-1}
							>
								<div class="flex justify-between gap-2 items-center">
									<div class="text-xs text-zinc-100">
										{featured?.data.date ? (
											<time datetime={new Date(featured?.data.date + "T12:00:00").toISOString()}>
												{Intl.DateTimeFormat(undefined, { dateStyle: "medium" }).format(new Date(featured?.data.date + "T12:00:00"))}
											</time>
										) : (
											<span>SOON</span>
										)}
									</div>
								</div>
								<h2
									class="mt-4 text-3xl font-bold text-zinc-100 group-hover:text-white sm:text-4xl font-display"
									transition:name={"blog-title-" + featured?.data.title}
								>
									{featured?.data.title}
								</h2>
								<p
									class="mt-4 leading-8 duration-150 text-zinc-400 group-hover:text-zinc-300 flex-1"
									transition:name={"blog-desc-" + featured?.data.title}
								>
									{featured?.data.description}
								</p>
								<div class="pt-4">
									<p class="text-zinc-200 hover:text-zinc-50 hidden lg:block">
										Read more <span aria-hidden="true">&rarr;</span>
									</p>
								</div>
							</article>
						</GlassCard>
					</a>

					<div class="flex flex-col w-full gap-8 border-t border-gray-900/10 lg:border-t-0">
						{[top2, top3].filter((b) => b !== undefined).map((blog) => (
							<GlassCard>
								<Blog id={blog.id} blog={blog.data} views={0} />
							</GlassCard>
						))}
					</div>
				</div>

				<div class="grid grid-cols-1 gap-4 lg:mx-0 md:grid-cols-3">
					<div class="grid grid-cols-1 gap-4">
						{remaining.filter((_, i) => i % 3 === 0).map((blog) => (
							<GlassCard>
								<Blog id={blog.id} blog={blog.data} views={0} />
							</GlassCard>
						))}
					</div>
					<div class="grid grid-cols-1 gap-4">
						{remaining.filter((_, i) => i % 3 === 1).map((blog) => (
							<GlassCard>
								<Blog id={blog.id} blog={blog.data} views={0} />
							</GlassCard>
						))}
					</div>
					<div class="grid grid-cols-1 gap-4">
						{remaining.filter((_, i) => i % 3 === 2).map((blog) => (
							<GlassCard>
								<Blog id={blog.id} blog={blog.data} views={0} />
							</GlassCard>
						))}
					</div>
				</div>
			</div>
		</div>
	</body>
</html>

<script is:inline>
  function setupBlogTracking() {
    // Track blog post card clicks from the listing page
    var blogLinks = document.querySelectorAll('a[href^="/blog/"]');
    blogLinks.forEach(function(link) {
      link.removeEventListener('click', handleBlogCardClick);
      link.addEventListener('click', handleBlogCardClick);
    });
  }

  function handleBlogCardClick(event) {
    var link = event.currentTarget;
    var href = link.getAttribute('href');
    var postId = href ? href.replace('/blog/', '') : '';
    var titleEl = link.querySelector('h2');
    var title = titleEl ? titleEl.textContent?.trim() : postId;
    window.posthog?.capture('blog_post_card_clicked', {
      post_id: postId,
      post_title: title
    });
  }

  document.addEventListener('DOMContentLoaded', setupBlogTracking);
  document.addEventListener('astro:page-load', setupBlogTracking);
</script>
