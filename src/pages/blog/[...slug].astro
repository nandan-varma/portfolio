---
import { type CollectionEntry, getCollection } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import Layout from "@/layouts/Layout.astro";
import "@/styles/mdx.css";

import { render } from "astro:content";
import { SITE_TITLE } from "@/consts";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
---

<Layout
	title={`${post.data.title} | ${SITE_TITLE}`}
	description={post.data.description}
	image={`/og/blog/${post.id}.png`}
	noindex={post.data.draft}
>
	<BlogPost {...post.data}>
		<article class="w-full py-4 mdx-body">
			<Content />
		</article>
	</BlogPost>
</Layout>

<script is:inline define:vars={{ postId: post.id, postTitle: post.data.title }}>
	function trackBlogPostOpened() {
		window.posthog?.capture("blog_post_opened", {
			post_id: postId,
			post_title: postTitle,
		});
	}

	document.addEventListener("DOMContentLoaded", trackBlogPostOpened);
	document.addEventListener("astro:page-load", trackBlogPostOpened);
</script>
