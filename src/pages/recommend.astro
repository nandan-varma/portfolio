---
import BaseHead from "@/components/layout/BaseHead.astro";
import { SITE_TITLE } from "@/consts";

const experienceBullets = [
    "Designed and shipped an AI feature using LLM tool-calling across multiple microservices, cutting user intent-to-action time by 50% and reaching 20% adoption in the first week.",
    "Built a React chat interface and inline content summarization features deployed to production, reducing time users spent searching large content collections.",
    "Engineered an LLM-powered dynamic compilation engine that tracked content changes over time and automatically regenerated accurate outputs, reducing stale content issues.",
    "Built an intelligent meeting summarization tool that searched distributed content repositories and injected relevant video clips into summaries for visual context.",
];

const sections = [
    {
        title: "Personal Info",
        fields: [
            { label: "Full name", value: "Nandan Varma Pericharla" },
            { label: "Email", value: "contact@nandan.fyi" },
            { label: "Phone", value: "206-837-3361", sensitive: true },
            { label: "Location", value: "Seattle, WA" },
            {
                label: "LinkedIn",
                value: "linkedin.com/in/nandanvarma",
                copyValue: "https://linkedin.com/in/nandanvarma",
            },
            {
                label: "Website",
                value: "nandan.fyi",
                copyValue: "https://nandan.fyi",
            },
            {
                label: "GitHub",
                value: "github.com/nandan-varma",
                copyValue: "https://github.com/nandan-varma",
            },
        ],
    },
    {
        title: "Work Authorization",
        fields: [
            { label: "Authorized to work in the US?", value: "Yes" },
            { label: "Require visa sponsorship (now or future)?", value: "No" },
            {
                label: "Citizenship / work status",
                value: "F1-OPT (authorized to work without sponsorship)",
            },
            { label: "US citizen or permanent resident?", value: "No" },
            { label: "Security clearance", value: "No" },
        ],
        note: "Answer sponsorship questions “No” — F1-OPT (starts Aug 10, 2026) plus an approved STEM OPT extension cover work authorization through ~Aug 2029. No need to bring up visa type beyond OPT.",
    },
    {
        title: "Experience",
        fields: [
            { label: "Job title", value: "Software Engineer Intern" },
            { label: "Company", value: "Highspot" },
            { label: "Location", value: "Seattle, WA" },
            { label: "Employment type", value: "Internship" },
            { label: "Start date", value: "July 2025" },
            { label: "End date", value: "September 2025" },
            { label: "Currently employed here?", value: "No" },
            {
                label: "Description",
                value: "Copy description",
                copyValue: experienceBullets.join("\n"),
            },
        ],
    },
    {
        title: "Education",
        fields: [
            {
                label: "Highest degree",
                value: "Master's (M.S. in Computer Science)",
            },
            { label: "Graduate school", value: "Seattle University" },
            { label: "Graduate graduation date", value: "June 2026" },
            { label: "Graduate GPA", value: "3.5 / 4.0" },
            {
                label: "Undergrad school",
                value: "Jawaharlal Nehru Technological University (BVRIT)",
            },
            {
                label: "Undergrad degree",
                value: "B.Tech. in Computer Science (Data Science)",
            },
            { label: "Undergrad graduation date", value: "August 2024" },
            { label: "Undergrad GPA", value: "8.23 / 10" },
        ],
    },
    {
        title: "Employment Details",
        fields: [
            {
                label: "Start date / availability",
                value: "Immediately (June 2026 if asked for graduation)",
                plain: true,
            },
            { label: "Notice period", value: "Immediate" },
            {
                label: "Desired salary",
                value: "$90,000",
                note: "Match the posted range if the listing gives one — this figure is only for forms with no range.",
            },
            { label: "Employment type", value: "Full-time" },
            { label: "Location preference", value: "Open to remote or hybrid" },
            { label: "Willing to relocate?", value: "Yes" },
            {
                label: "Years of professional experience",
                value: "Entry level",
                note: "~3-month Software Engineer Internship at Highspot (Jul–Sep 2025); graduating June 2026 — no full year of experience yet.",
            },
            { label: "Current employer", value: "Seattle University" },
            { label: "Current role", value: "Graduate Student" },
        ],
    },
    {
        title: "Skills",
        fields: [
            {
                label: "Languages",
                value: "Java, Python, C/C++, TypeScript, JavaScript, Go, Rust, SQL, Bash",
            },
            {
                label: "Cloud & DevOps",
                value: "AWS, GCP, Azure, Docker, CI/CD, Linux",
            },
            {
                label: "Distributed Systems",
                value: "Microservices, fault-tolerant service design, scalable data pipelines",
            },
            { label: "Databases", value: "PostgreSQL, SQLite, NoSQL" },
            { label: "Frameworks", value: "React, Next.js, Node.js, Express" },
            {
                label: "AI/ML",
                value: "LLM integration, prompt engineering, OpenAI API, AI-assisted development tools",
            },
            { label: "Mobile", value: "React Native, Expo, SQLite, EAS" },
            {
                label: "Native / Desktop",
                value: "Swift, SwiftUI, AppKit, Tauri, Rust",
            },
            {
                label: "Security",
                value: "Auth/RBAC design, capability-based security models, dependency/resource-exhaustion hardening, observability & incident triage",
            },
        ],
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`Recommendation Info | ${SITE_TITLE}`}
            description="Application information"
            noindex={true}
        />
    </head>
    <body class="bg-black min-h-screen">
        <div class="glow" aria-hidden="true"></div>

        <main class="relative z-10 mx-auto max-w-2xl px-6 py-16 sm:px-8 sm:py-20 lg:max-w-5xl lg:px-12">
            <header>
                <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
                    Recommendation Info
                </h1>
                <p class="mt-3 max-w-lg text-sm leading-6 text-white/50 sm:text-base">
                    Reference sheet for Application forms for Nandan Varma
                    Pericharla. Tap any value to copy it.
                </p>
            </header>

            <div class="mt-12 space-y-12 sm:mt-16 lg:grid lg:grid-cols-2 lg:items-start lg:gap-x-12 lg:gap-y-14 lg:space-y-0">
                {sections.map((section) => (
                    <section>
                        <h2 class="text-xs font-semibold uppercase tracking-wider text-white/35">
                            {section.title}
                        </h2>
                        <ul class="mt-4 divide-y divide-white/10 border-t border-white/10">
                            {section.fields.map((field) => (
                                <li class="py-3">
                                    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                                        <span
                                            data-field-label
                                            class="text-sm text-white/40"
                                        >
                                            {field.label}
                                        </span>
                                        {field.plain ? (
                                            <span class="text-sm text-white/80 sm:text-right">
                                                {field.value}
                                            </span>
                                        ) : field.sensitive ? (
                                            <button
                                                type="button"
                                                data-reveal
                                                data-value={field.value}
                                                aria-label={`Reveal ${field.label}`}
                                                class="group flex items-center gap-2 text-left text-sm text-white/80 sm:text-right"
                                            >
                                                <span data-reveal-text>
                                                    Tap to reveal
                                                </span>
                                                <span
                                                    data-reveal-icon-eye
                                                    class="shrink-0 text-white/25 group-hover:text-white/60"
                                                >
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="14"
                                                        height="14"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    >
                                                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                                                        <circle
                                                            cx="12"
                                                            cy="12"
                                                            r="3"
                                                        />
                                                    </svg>
                                                </span>
                                                <span
                                                    data-reveal-icon-copy
                                                    class="hidden shrink-0 text-white/25 group-hover:text-white/60"
                                                >
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="14"
                                                        height="14"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    >
                                                        <rect
                                                            width="14"
                                                            height="14"
                                                            x="8"
                                                            y="8"
                                                            rx="2"
                                                        />
                                                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                                                    </svg>
                                                </span>
                                            </button>
                                        ) : (
                                            <button
                                                type="button"
                                                data-copy
                                                data-value={
                                                    field.copyValue ??
                                                    field.value
                                                }
                                                aria-label={`Copy ${field.label}`}
                                                class="group flex items-center gap-2 text-left text-sm text-white/80 hover:text-white sm:text-right"
                                            >
                                                <span data-copy-text>
                                                    {field.value}
                                                </span>
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="14"
                                                    height="14"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    class="shrink-0 text-white/25 group-hover:text-white/60"
                                                >
                                                    <rect
                                                        width="14"
                                                        height="14"
                                                        x="8"
                                                        y="8"
                                                        rx="2"
                                                    />
                                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                                                </svg>
                                            </button>
                                        )}
                                    </div>
                                    {field.note && (
                                        <p class="mt-1 text-xs italic leading-5 text-white/30 sm:text-right">
                                            {field.note}
                                        </p>
                                    )}
                                </li>
                            ))}
                        </ul>
                        {section.note && (
                            <p class="mt-3 text-xs italic leading-5 text-white/30">
                                {section.note}
                            </p>
                        )}
                    </section>
                ))}
            </div>
        </main>

        <script is:inline>
            function recommendFieldLabel(button) {
                return button
                    .closest("li")
                    ?.querySelector("[data-field-label]")
                    ?.textContent?.trim();
            }

            function recommendCopy(button, value, textEl) {
                const el = textEl || button.querySelector("[data-copy-text]");
                const original = el.textContent;
                navigator.clipboard
                    ?.writeText(value || "")
                    .then(() => {
                        el.textContent = "Copied";
                        setTimeout(() => {
                            el.textContent = original;
                        }, 1200);
                    })
                    .catch(() => {});
                window.posthog?.capture("recommend_field_copied", {
                    field: recommendFieldLabel(button),
                });
            }

            function handleCopyClick(event) {
                const button = event.currentTarget;
                recommendCopy(button, button.getAttribute("data-value"));
            }

            function handleRevealClick(event) {
                const button = event.currentTarget;
                const textEl = button.querySelector("[data-reveal-text]");
                const value = button.getAttribute("data-value");
                if (textEl.textContent === "Tap to reveal") {
                    textEl.textContent = value;
                    button
                        .querySelector("[data-reveal-icon-eye]")
                        ?.classList.add("hidden");
                    button
                        .querySelector("[data-reveal-icon-copy]")
                        ?.classList.remove("hidden");
                    window.posthog?.capture("recommend_field_revealed", {
                        field: recommendFieldLabel(button),
                    });
                } else {
                    recommendCopy(button, value, textEl);
                }
            }

            function setupRecommendPage() {
                document.querySelectorAll("[data-copy]").forEach((button) => {
                    button.removeEventListener("click", handleCopyClick);
                    button.addEventListener("click", handleCopyClick);
                });
                document.querySelectorAll("[data-reveal]").forEach((button) => {
                    button.removeEventListener("click", handleRevealClick);
                    button.addEventListener("click", handleRevealClick);
                });
            }

            document.addEventListener("DOMContentLoaded", setupRecommendPage);
            document.addEventListener("astro:page-load", setupRecommendPage);
        </script>
        <style>
            body {
                background-color: black;
            }

            .glow {
                position: fixed;
                top: -20%;
                left: 50%;
                width: 60vw;
                height: 60vw;
                max-width: 900px;
                max-height: 900px;
                transform: translateX(-50%);
                background: radial-gradient(
                    circle,
                    rgba(99, 102, 241, 0.12),
                    rgba(99, 102, 241, 0) 70%
                );
                filter: blur(60px);
                pointer-events: none;
                z-index: 0;
            }
        </style>
    </body>
</html>
