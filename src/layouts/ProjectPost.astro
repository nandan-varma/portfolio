---
import type { CollectionEntry } from "astro:content";

type Props = CollectionEntry<"project">["data"];

const { title, description, repository, url } = Astro.props;
---

<header class="relative overflow-hidden pt-32 pb-10 sm:pt-40 sm:pb-12 px-4 sm:px-6">
	<div class="mx-auto max-w-3xl text-center flex flex-col items-center">
		<h1
			class="text-4xl sm:text-6xl font-bold tracking-tight text-fg"
			transition:name={"project-title-" + title}
		>
			{title}
		</h1>
		<p
			class="mt-6 text-base sm:text-lg leading-8 text-muted-fg"
			transition:name={"project-desc-" + title}
		>
			{description}
		</p>

		<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
			{
				repository && (
					<a
						target="_blank"
						href={`https://github.com/${repository}`}
						class="btn btn-primary"
						data-external-link="github"
					>
						GitHub <span aria-hidden="true">&rarr;</span>
					</a>
				)
			}
			{
				url && (
					<a
						target="_blank"
						href={url}
						class="btn btn-secondary"
						data-external-link="website"
					>
						Website <span aria-hidden="true">&rarr;</span>
					</a>
				)
			}
		</div>
	</div>
</header>

<div class="container mx-auto px-4 sm:px-6 max-w-3xl w-full pb-24">
	<slot />

	<div class="mt-16 pt-8 border-t border-border">
		<a href="/projects" class="nav-link px-0! text-sm font-semibold text-brand hover:bg-transparent hover:opacity-70">
			&larr; Back to all projects
		</a>
	</div>
</div>

<script is:inline define:vars={{ projectTitle: title }}>
	function setupExternalLinkTracking() {
		document.querySelectorAll("[data-external-link]").forEach(function (link) {
			link.removeEventListener("click", handleExternalLinkClick);
			link.addEventListener("click", handleExternalLinkClick);
		});
	}

	function handleExternalLinkClick(event) {
		var link = event.currentTarget;
		window.posthog?.capture("external_project_link_clicked", {
			project_title: projectTitle,
			link_type: link.getAttribute("data-external-link"),
			link_url: link.getAttribute("href") || "",
			link_text: link.textContent?.trim() || "",
		});
	}

	document.addEventListener("DOMContentLoaded", setupExternalLinkTracking);
	document.addEventListener("astro:page-load", setupExternalLinkTracking);
</script>
