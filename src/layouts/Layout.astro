---
import BaseHead from "@/components/layout/BaseHead.astro";
import Navigation from "@/components/layout/Navigation.astro";
import ScrollReveal from "@/components/ScrollReveal.astro";

interface Props {
	title: string;
	description: string;
	image?: string;
	noindex?: boolean;
	nav?: boolean;
	navPosition?: "top" | "bottom";
	navShowBack?: boolean;
}

const {
	title,
	description,
	image,
	noindex = false,
	nav = true,
	navPosition = "top",
	navShowBack = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} noindex={noindex} />
	</head>
	<body class="min-h-screen flex flex-col">
		{nav && <Navigation position={navPosition} showBack={navShowBack} />}
		<main class="relative z-10 flex-1 flex flex-col">
			<slot />
		</main>
		<ScrollReveal />
	</body>
</html>
