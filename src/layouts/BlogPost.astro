---
import type { CollectionEntry } from "astro:content";

type Props = CollectionEntry<"blog">["data"];

const { title, description, draft } = Astro.props;
---

<header class="relative overflow-hidden pt-32 pb-10 sm:pt-40 sm:pb-12 px-4 sm:px-6">
	<div class="mx-auto max-w-3xl text-center flex flex-col items-center">
		<h1
			class="text-4xl sm:text-6xl font-bold tracking-tight text-fg"
			transition:name={"blog-title-" + title}
		>
			{title}
		</h1>
		<p
			class="mt-6 text-base sm:text-lg leading-8 text-muted-fg"
			transition:name={"blog-desc-" + title}
		>
			{description}
		</p>
		{
			draft && (
				<p class="mt-4 chip bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20">
					This post is a draft and may not be complete.
				</p>
			)
		}
	</div>
</header>

<div class="container mx-auto px-4 sm:px-6 max-w-3xl w-full pb-24">
	<slot />

	<div class="mt-16 pt-8 border-t border-border">
		<a href="/blog" class="nav-link px-0! text-sm font-semibold text-brand hover:bg-transparent hover:opacity-70">
			&larr; Back to all posts
		</a>
	</div>
</div>
