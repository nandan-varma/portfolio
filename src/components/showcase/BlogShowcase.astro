---
interface Props {
  blogs: any[];
}

const { blogs } = Astro.props;
const latestBlogs = blogs.slice(0, 3);
---

<div class="blog-showcase">
  {latestBlogs.map((blog, i) => (
    <a 
      href={`/blog/${blog.id}`} 
      class="blog-item"
      style={`--delay: ${i * 0.15}s`}
    >
      <div class="blog-spotlight"></div>
      <div class="blog-shine"></div>
      
      <div class="blog-inner">
        <div class="blog-header">
          <div class="blog-icon">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </div>
          <div class="blog-meta">
            <time class="blog-date">
              {Intl.DateTimeFormat(undefined, { year: "numeric", month: "short", day: "numeric" }).format(new Date(blog.data.date))}
            </time>
            <span class="blog-read-time">{blog.data.readTime || "5 min read"}</span>
          </div>
        </div>
        
        <h3 class="blog-title" transition:name={`blog-title-${blog.id}`}>
          {blog.data.title}
        </h3>
        
        <p class="blog-description">
          {blog.data.description}
        </p>
        
        <div class="blog-footer">
          <span class="blog-cta">
            Read article
            <svg class="blog-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </div>
      </div>
    </a>
  ))}
</div>

<style>
  .blog-showcase {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .blog-item {
    position: relative;
    display: block;
    padding: 1.5rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
    border: 1px solid rgba(255,255,255,0.06);
    overflow: hidden;
    opacity: 0;
    animation: slideUp 0.6s ease-out forwards;
    animation-delay: var(--delay);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .blog-item:hover {
    transform: translateY(-2px);
    border-color: rgba(255,255,255,0.15);
    background: linear-gradient(135deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.02) 100%);
  }

  .blog-spotlight {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(800px at var(--x, 50%) var(--y, 50%), rgba(255,255,255,0.07), transparent 50%);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .blog-item:hover .blog-spotlight {
    opacity: 1;
  }

  .blog-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,0.04),
      transparent
    );
    transition: left 0.6s ease;
    pointer-events: none;
  }

  .blog-item:hover .blog-shine {
    left: 100%;
  }

  .blog-inner {
    position: relative;
    z-index: 1;
  }

  .blog-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .blog-icon {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.06);
    border-radius: 0.75rem;
    color: rgba(255,255,255,0.6);
    transition: all 0.3s ease;
  }

  .blog-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .blog-item:hover .blog-icon {
    background: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.9);
    transform: rotate(-3deg) scale(1.05);
  }

  .blog-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .blog-date {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.4);
  }

  .blog-read-time {
    font-size: 0.625rem;
    padding: 0.2rem 0.5rem;
    background: rgba(255,255,255,0.08);
    border-radius: 9999px;
    color: rgba(255,255,255,0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blog-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: rgba(255,255,255,0.9);
    margin: 0 0 0.5rem 0;
    transition: color 0.3s ease;
  }

  .blog-item:hover .blog-title {
    color: #fff;
  }

  .blog-description {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.5);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.3s ease;
  }

  .blog-item:hover .blog-description {
    color: rgba(255,255,255,0.7);
  }

  .blog-footer {
    margin-top: 1rem;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s ease;
  }

  .blog-item:hover .blog-footer {
    opacity: 1;
    transform: translateX(0);
  }

  .blog-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.5);
    transition: color 0.3s ease;
  }

  .blog-item:hover .blog-cta {
    color: rgba(255,255,255,0.9);
  }

  .blog-arrow {
    width: 1rem;
    height: 1rem;
    transition: transform 0.3s ease;
  }

  .blog-item:hover .blog-arrow {
    transform: translateX(4px);
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  function initBlogShowcase() {
    const items = document.querySelectorAll('.blog-item');
    
    items.forEach(item => {
      const handleMouseMove = (e: MouseEvent) => {
        const rect = (item as HTMLElement).getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        
        (item as HTMLElement).style.setProperty('--x', `${x}%`);
        (item as HTMLElement).style.setProperty('--y', `${y}%`);
      };
      
      (item as HTMLElement).addEventListener('mousemove', handleMouseMove as EventListener);
    });
  }
  
  initBlogShowcase();
  document.addEventListener('astro:page-load', initBlogShowcase);
</script>