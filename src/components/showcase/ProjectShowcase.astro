---
interface Props {
  projects: any[];
}

const { projects } = Astro.props;
const featuredProjects = projects.slice(0, 3);
---

<div class="project-showcase">
  {featuredProjects.map((project, i) => (
    <a 
      href={`/projects/${project.id}`} 
      class="project-item"
      style={`--delay: ${i * 0.15}s`}
    >
      <div class="project-spotlight"></div>
      <div class="project-glow"></div>
      
      <div class="project-inner">
        <div class="project-header">
          <span class="project-emoji">{project.data.emoji || "📦"}</span>
          <div class="project-meta">
            <time class="project-date">
              {Intl.DateTimeFormat(undefined, { year: "numeric", month: "short" }).format(new Date(project.data.date))}
            </time>
            {project.data.tags && project.data.tags.slice(0, 2).map((tag: string) => (
              <span class="project-tag">{tag}</span>
            ))}
          </div>
        </div>
        
        <h3 class="project-title" transition:name={`project-title-${project.data.title}`}>
          {project.data.title}
        </h3>
        
        <p class="project-description" transition:name={`project-desc-${project.data.title}`}>
          {project.data.description}
        </p>
        
        <div class="project-footer">
          <span class="project-cta">
            View project
            <svg class="project-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </div>
      </div>
    </a>
  ))}
</div>

<style>
  .project-showcase {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-item {
    position: relative;
    display: block;
    padding: 1.5rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
    border: 1px solid rgba(255,255,255,0.06);
    overflow: hidden;
    opacity: 0;
    animation: slideUp 0.6s ease-out forwards;
    animation-delay: var(--delay);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-item:hover {
    transform: translateY(-2px);
    border-color: rgba(255,255,255,0.15);
    background: linear-gradient(135deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.02) 100%);
  }

  .project-spotlight {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(800px at var(--x, 50%) var(--y, 50%), rgba(255,255,255,0.07), transparent 50%);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .project-item:hover .project-spotlight {
    opacity: 1;
  }

  .project-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
    transition: all 0.6s ease;
    pointer-events: none;
  }

  .project-item:hover .project-glow {
    opacity: 1;
    transform: translate(-50%, -50%) scale(2);
  }

  .project-inner {
    position: relative;
    z-index: 1;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .project-emoji {
    font-size: 2rem;
    line-height: 1;
    transition: transform 0.3s ease;
  }

  .project-item:hover .project-emoji {
    transform: scale(1.1);
  }

  .project-meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .project-date {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.4);
  }

  .project-tag {
    font-size: 0.625rem;
    padding: 0.2rem 0.5rem;
    background: rgba(255,255,255,0.08);
    border-radius: 9999px;
    color: rgba(255,255,255,0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: rgba(255,255,255,0.9);
    margin: 0 0 0.5rem 0;
    transition: color 0.3s ease;
  }

  .project-item:hover .project-title {
    color: #fff;
  }

  .project-description {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.5);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.3s ease;
  }

  .project-item:hover .project-description {
    color: rgba(255,255,255,0.7);
  }

  .project-footer {
    margin-top: 1rem;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s ease;
  }

  .project-item:hover .project-footer {
    opacity: 1;
    transform: translateX(0);
  }

  .project-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.5);
    transition: color 0.3s ease;
  }

  .project-item:hover .project-cta {
    color: rgba(255,255,255,0.9);
  }

  .project-arrow {
    width: 1rem;
    height: 1rem;
    transition: transform 0.3s ease;
  }

  .project-item:hover .project-arrow {
    transform: translateX(4px);
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  function initProjectShowcase() {
    const items = document.querySelectorAll('.project-item');
    
    items.forEach(item => {
      const handleMouseMove = (e: MouseEvent) => {
        const rect = (item as HTMLElement).getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        
        (item as HTMLElement).style.setProperty('--x', `${x}%`);
        (item as HTMLElement).style.setProperty('--y', `${y}%`);
      };
      
      (item as HTMLElement).addEventListener('mousemove', handleMouseMove as EventListener);
    });
  }
  
  initProjectShowcase();
  document.addEventListener('astro:page-load', initProjectShowcase);
</script>