---
import type { Blog } from "@/content.config";

interface Props {
  id: string;
  blog: Blog;
  views: number;
}

const { id, blog } = Astro.props;
---

<a href={`/blog/${id}`} class="block w-full h-full group">
  <article class="p-6">
    <span class="text-xs font-medium text-muted-fg">
      {blog.date ? (
        <time datetime={new Date(blog.date + "T12:00:00").toISOString()}>
          {Intl.DateTimeFormat(undefined, { dateStyle: "medium" }).format(
            new Date(blog.date + "T12:00:00")
          )}
        </time>
      ) : (
        <span>SOON</span>
      )}
    </span>
    <h2
      class="mt-3 text-xl font-semibold text-fg transition-colors duration-300 group-hover:text-brand"
      transition:name={`blog-title-${blog.title}`}
    >
      {blog.title}
    </h2>
    <p
      class="mt-2 text-sm text-muted-fg line-clamp-3"
      transition:name={`blog-desc-${blog.title}`}
    >
      {blog.description}
    </p>
  </article>
</a>
