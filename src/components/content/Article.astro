---
import type { Project } from "@/content.config";

interface Props {
  id: string;
  project: Project;
  views: number;
}

const { id, project } = Astro.props;
---

<a href={`/projects/${id}`} class="block w-full h-full group">
  <article class="p-6" tabindex={-1}>
    <span class="text-xs font-medium text-muted-fg">
      {project.date ? (
        <time datetime={new Date(project.date + "T12:00:00").toISOString()}>
          {Intl.DateTimeFormat(undefined, { dateStyle: "medium" }).format(
            new Date(project.date + "T12:00:00")
          )}
        </time>
      ) : (
        <span>SOON</span>
      )}
    </span>
    <h2
      class="mt-3 text-xl font-semibold text-fg transition-colors duration-300 group-hover:text-brand"
      transition:name={`project-title-${project.title}`}
    >
      {project.title}
    </h2>
    <p
      class="mt-2 text-sm text-muted-fg line-clamp-3"
      transition:name={`project-desc-${project.title}`}
    >
      {project.description}
    </p>
  </article>
</a>
