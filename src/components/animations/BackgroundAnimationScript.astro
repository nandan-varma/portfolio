<script>
	import { BackgroundAnimationController } from "@/lib/animations/backgroundAnimationController";

	declare global {
		interface Window {
			__backgroundController?: BackgroundAnimationController;
		}
	}

	let nextText: string | undefined;

	function updateBackground() {
		const canvas = document.getElementById("background-canvas") as HTMLCanvasElement | null;
		const previous = window.__backgroundController;

		// Astro preserves the canvas between section pages, including its bitmap
		// and simulation. Update the text before the destination snapshot is taken.
		if (canvas && previous?.ownsCanvas(canvas)) {
			previous.setText(nextText);
			return;
		}

		previous?.saveMousePosition();
		previous?.cleanup();
		window.__backgroundController = undefined;
		if (!canvas) return;

		const controller = new BackgroundAnimationController(canvas, nextText);
		try {
			const stored = sessionStorage.getItem("torchPosition");
			if (stored) {
				const position = JSON.parse(stored);
				if (Number.isFinite(position?.x) && Number.isFinite(position?.y)) {
					controller.setMousePosition(position.x, position.y);
				}
			}
		} catch {
			// Storage can be unavailable or contain an invalid previous value.
		}
		window.__backgroundController = controller;
		controller.start();
	}

	document.addEventListener("astro:before-swap", (event) => {
		nextText = event.newDocument.getElementById("background-canvas")?.dataset.text;
		window.__backgroundController?.saveMousePosition();
	});
	document.addEventListener("astro:after-swap", updateBackground);

	// Also runs on a direct article visit, so later navigation can prepare a
	// canvas synchronously in after-swap instead of waiting for new scripts.
	nextText = document.getElementById("background-canvas")?.dataset.text;
	updateBackground();
</script>
