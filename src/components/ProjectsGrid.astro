---
import GlassCard from "@/components/cards/GlassCard.astro";
import Article from "@/components/content/Article.astro";

interface Props {
	projects: any[];
	showAll?: boolean;
	showTitle?: boolean;
}

const { projects, showAll = false, showTitle = true } = Astro.props;

const featured = projects[0];
const top2 = projects[1];
const top3 = projects[2];
const sorted = showAll ? projects.slice(3) : projects.slice(3, 6);
const hasMore = !showAll && projects.length > 6;
---

{showTitle && (
	<div class="flex items-center gap-4 mb-8">
		<h2 class="text-2xl md:text-3xl font-semibold text-zinc-200">
			Projects
		</h2>
		<div class="h-px flex-1 bg-zinc-800"></div>
	</div>
)}

	<div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
		<a href={`/projects/${featured?.id}`} class="block h-full">
			<GlassCard class="h-full" index={0}>
				<article
					class="relative w-full p-4 md:p-8 flex flex-col min-h-full"
					tabindex={-1}
				>
					<div class="flex justify-between gap-2 items-center">
						<div class="text-xs text-zinc-100">
							{
								featured?.data.date ? (
									<time
										datetime={new Date(
											featured?.data.date,
										).toISOString()}
									>
										{Intl.DateTimeFormat(
											undefined,
											{
												dateStyle: "medium",
											},
										).format(
											new Date(
												featured?.data.date,
											),
										)}
									</time>
								) : (
									<span>SOON</span>
								)
							}
						</div>
					</div>

					<h2
						class="mt-4 text-3xl font-bold text-zinc-100 group-hover:text-white sm:text-4xl font-display"
						transition:name={`project-title-${featured?.data.title}`}
					>
						{featured?.data.title}
					</h2>
					<p
						class="mt-4 leading-8 duration-150 text-zinc-400 group-hover:text-zinc-300 flex-1"
						transition:name={`project-desc-${featured?.data.title}`}
					>
						{featured?.data.description}
					</p>
					<div class="pt-4">
						<p class="text-zinc-200 hover:text-zinc-50 hidden lg:block">
							Read more <span aria-hidden="true">&rarr;</span>
						</p>
					</div>
				</article>
			</GlassCard>
		</a>

		<div class="flex flex-col w-full gap-8 border-t border-gray-900/10 lg:border-t-0">
			{
				[top2, top3]
					.filter((project) => project !== undefined)
					.map((project, i) => (
						<GlassCard index={i + 1}>
							<Article
								id={project.id}
								project={project.data}
								views={0}
							/>
						</GlassCard>
					))
			}
		</div>
	</div>

	<div class="grid grid-cols-1 gap-4 lg:mx-0 md:grid-cols-3 mt-8">
		<div class="grid grid-cols-1 gap-4">
			{
				sorted
					.filter((_, i) => i % 3 === 0)
					.map((project, i) => (
						<GlassCard index={i * 3 + 3}>
							<Article
								id={project.id}
								project={project.data}
								views={0}
							/>
						</GlassCard>
					))
			}
		</div>
		<div class="grid grid-cols-1 gap-4">
			{
				sorted
					.filter((_, i) => i % 3 === 1)
					.map((project, i) => (
						<GlassCard index={i * 3 + 4}>
							<Article
								id={project.id}
								project={project.data}
								views={0}
							/>
						</GlassCard>
					))
			}
		</div>
		<div class="grid grid-cols-1 gap-4">
			{
				sorted
					.filter((_, i) => i % 3 === 2)
					.map((project, i) => (
						<GlassCard index={i * 3 + 5}>
							<Article
								id={project.id}
								project={project.data}
								views={0}
							/>
						</GlassCard>
					))
			}
		</div>
	</div>

	{hasMore && (
		<div class="mt-12 flex justify-center">
			<a
				href="/projects"
				class="px-8 py-3 rounded-full border border-zinc-700 text-zinc-300 hover:text-zinc-100 hover:border-zinc-500 transition-all duration-300"
			>
				Show more →
			</a>
		</div>
	)}
</section>