---
// TimelineItem.astro
// Props: project (object), side ("left" | "right"), isLast (boolean)
const { project, side, isLast } = Astro.props;
---

<article
  class={[
    "timeline-item",
    side === "left" ? "timeline-item-left" : "timeline-item-right",
    isLast ? "timeline-item-last" : ""
  ].join(" ")}
  tabindex="0"
>
  <div class="timeline-dot" aria-hidden="true"></div>
  <div class="timeline-content">
    <header class="timeline-header">
      <span class="timeline-date-badge">{new Date(project.date).toLocaleDateString(undefined, { year: 'numeric', month: 'short' })}</span>
      <h3 class="timeline-title">
        {project.emoji && <span class="timeline-emoji">{project.emoji}</span>} 
        {project.title}
      </h3>
    </header>
    <div class="timeline-description">{project.description}</div>
    <img
      src={project.heroImage}
      alt={project.title + " hero image"}
      class="timeline-hero-image"
      loading="lazy"
      decoding="async"
      width="480"
      height="270"
    />
    <footer class="timeline-actions">
      {project.url && ( 
        <a href={project.url} class="glass-btn" target="_blank" rel="noopener noreferrer">View Project</a>
      )} 
      <a href={project.repository} class="glass-btn glass-btn-secondary" target="_blank" rel="noopener noreferrer">Repository</a>
    </footer>
  </div>
</article>

<style>
.timeline-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin: 0 0 4rem 0;
  outline: none;
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.7s cubic-bezier(.4,0,.2,1), transform 0.7s cubic-bezier(.4,0,.2,1);
  will-change: opacity, transform;
  scroll-snap-align: start;
}
.timeline-item.visible {
  opacity: 1;
  transform: translateY(0);
}
.timeline-item-left {
  align-self: flex-end;
  flex-direction: row-reverse;
}
.timeline-item-right {
  align-self: flex-start;
  flex-direction: row;
}
.timeline-dot {
  position: absolute;
  left: 50%;
  top: 2.5rem;
  transform: translate(-50%, 0);
  width: 1.25rem;
  height: 1.25rem;
  background: rgba(255,255,255,0.85);
  border-radius: 50%;
  box-shadow: 0 0 0 6px rgba(255,255,255,0.12), 0 2px 8px rgba(0,0,0,0.10);
  z-index: 10;
  transition: box-shadow 0.3s;
}
.timeline-item:hover .timeline-dot {
  box-shadow: 0 0 0 12px rgba(255,255,255,0.18), 0 4px 16px rgba(0,0,0,0.18);
}
.timeline-content {
  backdrop-filter: blur(8px);
  border-radius: 1.25rem;
  box-shadow: 0 4px 32px rgba(0,0,0,0.25), 0 1.5px 8px rgba(56,189,248,0.08);
  padding: 2rem 2.5rem 1.5rem 2.5rem;
  min-width: 320px;
  max-width: 480px;
  color: var(--text, #f1f5f9);
  margin-left: 2.5rem;
  margin-right: 2.5rem;
  transition: box-shadow 0.3s;
}
.timeline-item-left .timeline-content {
  margin-right: 0;
}
.timeline-item-right .timeline-content {
  margin-left: 0;
}
.timeline-content:focus-within, .timeline-item:focus {
  box-shadow: 0 0 0 4px var(--accent, #38bdf8), 0 4px 32px rgba(0,0,0,0.25);
}
.timeline-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.5rem;
}
.timeline-title {
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.timeline-emoji {
  font-size: 1.5rem;
  margin-right: 0.25rem;
}
.timeline-date-badge {
  background: rgba(255,255,255,0.85);
  color: #222;
  font-size: 0.95rem;
  font-weight: 600;
  border-radius: 999px;
  padding: 0.25rem 0.9rem;
  margin-right: 0.75rem;
  box-shadow: 0 1px 4px rgba(255,255,255,0.12);
  position: relative;
  left: 0;
  z-index: 3;
}
.timeline-description {
  margin: 1rem 0 1.5rem 0;
  font-size: 1.1rem;
  color: var(--text-secondary, #cbd5e1);
}
.timeline-hero-image {
  width: 100%;
  max-width: 420px;
  border-radius: 1rem;
  margin-bottom: 1.25rem;
  box-shadow: 0 2px 16px rgba(56,189,248,0.10), 0 1.5px 8px rgba(0,0,0,0.10);
  opacity: 0;
  transform: scale(0.97);
  transition: opacity 0.7s cubic-bezier(.4,0,.2,1), transform 0.7s cubic-bezier(.4,0,.2,1);
  will-change: opacity, transform;
}
.timeline-item.visible .timeline-hero-image {
  opacity: 1;
  transform: scale(1.03);
}
.timeline-actions {
  display: flex;
  gap: 1rem;
  margin-top: 0.5rem;
}
.glass-btn {
  background: rgba(255,255,255,0.10);
  color: #fff;
  border: 1.5px solid rgba(255,255,255,0.25);
  box-shadow: 0 1px 8px rgba(255,255,255,0.10), 0 1.5px 8px rgba(255,255,255,0.04);
  backdrop-filter: blur(8px) saturate(1.2);
  -webkit-backdrop-filter: blur(8px) saturate(1.2);
  font-weight: 600;
  border-radius: 999px;
  padding: 0.5rem 1.5rem;
  font-size: 1rem;
  text-decoration: none;
  outline: none;
  transition: background 0.2s, box-shadow 0.2s, color 0.2s;
}
.glass-btn:focus, .glass-btn:hover {
  background: rgba(255,255,255,0.25);
  color: #222;
  box-shadow: 0 2px 16px rgba(255,255,255,0.18), 0 2px 16px rgba(255,255,255,0.10);
}
.glass-btn-secondary {
  background: rgba(255,255,255,0.05);
  color: #fff;
  border: 1.5px solid rgba(255,255,255,0.25);
}
.glass-btn-secondary:focus, .glass-btn-secondary:hover {
  background: rgba(255,255,255,0.25);
  color: #222;
}
@media (max-width: 900px) {
  .timeline-content {
    min-width: 0;
    max-width: 100vw;
    padding: 1.5rem 1rem 1rem 1rem;
  }
}
@media (max-width: 700px) {
  .timeline-item, .timeline-item-left, .timeline-item-right {
    align-self: stretch;
    flex-direction: column;
  }
  .timeline-content {
    margin: 0 0 0 2.5rem;
    min-width: 0;
    max-width: 100vw;
  }
  .timeline-dot {
    left: 50%;
    top: 2.5rem;
    transform: translate(-50%, 0);
    width: 1.25rem;
    height: 1.25rem;
  }
  .timeline-date-badge {
    left: 0;
  }
}
@media (max-width: 500px) {
  .timeline-content {
    padding: 1rem 0.5rem 0.5rem 0.5rem;
    margin-left: 1.5rem;
  }
  .timeline-dot {
    left: 50%;
    top: 2.5rem;
    transform: translate(-50%, 0);
    width: 0.9rem;
    height: 0.9rem;
  }
}
@media (prefers-color-scheme: dark) {
  .timeline-content {
    background: rgba(34, 34, 34, 0.85);
    color: #f1f5f9;
  }
}
@media (prefers-reduced-motion: reduce) {
  .timeline-item, .timeline-hero-image {
    transition: none !important;
  }
}
</style>
