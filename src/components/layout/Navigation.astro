---
interface Props {
	position?: "top" | "bottom";
	showBack?: boolean;
}

const { position = "top", showBack = true } = Astro.props;
---

<header
	class:list={[
		"fixed inset-x-0 z-50 px-4",
		position === "bottom" ? "bottom-4" : "top-4",
	]}
	transition:name="site-nav"
>
	<nav
		class:list={[
			"flex items-center gap-4 mx-auto max-w-3xl px-4 py-2.5 rounded-lg border border-card-border bg-card/90 backdrop-blur-md shadow-[inset_0_1px_0_rgba(255,255,255,0.06),0_1px_2px_rgba(0,0,0,0.08),0_8px_20px_-8px_rgba(0,0,0,0.15)]",
			showBack ? "justify-between" : "justify-center",
		]}
	>
		{
			showBack && (
				<a
					href="/"
					class="nav-link text-fg font-bold hover:bg-bg-soft"
					transition:name="nav-back"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="m12 19-7-7 7-7" />
						<path d="M19 12H5" />
					</svg>
				</a>
			)
		}

		<div class="flex items-center gap-0.5 sm:gap-1 text-sm sm:text-base">
			<a
				href="/projects"
				class="nav-link px-2.5! sm:px-4! text-muted-fg hover:text-fg hover:bg-bg-soft"
				transition:name={"Projects-Nav"}
			>
				Projects
			</a>
			<a
				href="/blog"
				class="nav-link px-2.5! sm:px-4! text-muted-fg hover:text-fg hover:bg-bg-soft"
				transition:name={"Blog-Nav"}
			>
				Blog
			</a>
			<a
				href="/contact"
				class="nav-link px-2.5! sm:px-4! text-muted-fg hover:text-fg hover:bg-bg-soft"
				transition:name={"Contact-Nav"}
			>
				Contact
			</a>
		</div>
	</nav>
</header>

<script is:inline>
	function setupNavTracking() {
		var navLinks = document.querySelectorAll("header nav a");
		navLinks.forEach(function (link) {
			link.removeEventListener("click", handleNavClick);
			link.addEventListener("click", handleNavClick);
		});
	}

	function handleNavClick(event) {
		var link = event.currentTarget;
		var href = link.getAttribute("href") || "";
		var label = link.textContent?.trim() || href;
		window.posthog?.capture("navigation_link_clicked", {
			nav_destination: href,
			nav_label: label,
		});
	}

	document.addEventListener("DOMContentLoaded", setupNavTracking);
	document.addEventListener("astro:page-load", setupNavTracking);
</script>
